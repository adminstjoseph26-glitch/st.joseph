{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sjc-college",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",

  // Static site (public/index.html) is served by Cloudflare directly.
  // The Worker only runs for /api/* requests.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sjc-db",
      "database_id": "PASTE-YOUR-DATABASE-ID-HERE",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "sjc-ebooks" }
  ]
}
